{% extends "base.html" %}

{% block css %}
<link rel="stylesheet" href="https://code.highcharts.com/css/highcharts.css" />
{% endblock %}

{% block content %}
<figure class="highcharts-figure">
	<div id="mschart"></div>
</figure>
<ul id="contextmenu">
	<li data-action="detail">Voir les détails</li>
	<li data-action="delete">Supprimer la donnée</li>
</ul>
{% endblock %}

{% block scripts %}
<script src="https://code.highcharts.com/es5/highcharts.js"></script>
<script src="https://code.highcharts.com/modules/mouse-wheel-zoom.js"></script>
<script src="https://code.highcharts.com/modules/exporting.js"></script>
<script src="https://code.highcharts.com/modules/export-data.js"></script>
<script src="https://code.highcharts.com/modules/accessibility.js"></script>
<script>
$(document).ready(function () {
  // Data from server
  const spectrum = [
    { x: 43.018,  y: 100.0 },
    { x: 60.021,  y: 62.4 },
    { x: 73.029,  y: 15.8 },
    { x: 91.018,  y: 8.2 },
    { x: 118.050, y: 24.1 },
  ];
  const reference = '{{ sample.reference }}';

  const $container = $('#mschart');
  const $menu = $('#contextmenu');

  const chart = Highcharts.chart('mschart', {
    chart: {
      type: 'column',
      zoomType: 'x',
	  zooming : {
	    mouseWheel: { enabled: true, type: 'x', showResetButton: true }
	  },
      panning: { enabled: true, type: 'x' },
	  panKey: 'ctrl',
      pinchType: 'x'
    },

    title: { text: reference },
    legend: { enabled: false },

    xAxis: {
      title: { text: 'm/z', style: { fontStyle: 'italic' } },
      minRange: 1,
      type: 'linear',
      startOnTick: false,
      endOnTick: false,
      labels: { format: '{value:.0f}' }
    },

    yAxis: {
      title: { text: 'Intensité relative (%)' },
      min: 0,
      endOnTick: true,
    },

    tooltip: {
      headerFormat: '',
      pointFormat: '<i>m/z</i> <b>{point.x:.4f}</b> — <b>{point.y:.2f}</b> %',
      shared: false
    },

    plotOptions: {
      series: {
		allowPointSelect: true,
        states: {
          hover: {
            color: 'red'
          }
        },
        dataLabels: {
          enabled: true,
          format: '{point.x:.4f}',
          style: { fontSize: '9px', color: '#333' },
          filter: {
			property: 'y',
			operator: '>',
			value: 5
		  }
        }
      },
      column: {
        pointPadding: 0,
        groupPadding: 0,
        pointWidth: 4,
        borderWidth: 0
      }
    },

    series: [{
      name: 'Intensities',
      data: spectrum,
      //turboThreshold: 0,           // important pour gros spectres : désactive la limite de 1000 pts
      cursor: 'pointer'
    }]
  });
  
  // ---- Reset zoom (bouton intégré existe, + double-clic et bouton custom) ----
  $container.on('dblclick', () => chart.zoomOut());

  // ---- Menu contextuel ----
  let activeDataIndex = null;
  
  $container.on('contextmenu', function (e) {
	  const point = chart.hoverPoint;     // point survolé, ou undefined si le vide

	  if (point) {
	  	e.preventDefault();
		activeDataIndex = point.index;
		$menu
		  .css({ left: e.clientX + 'px', top: e.clientY + 'px' })
		  .show();
	  } else {
		// clic droit dans le vide
		activeDataIndex = null;
		$menu.hide();
	  }
	});

  $menu.on('click', 'li', function () {
    const action = $(this).data('action');
    if (activeDataIndex !== null) {
      const val = spectrum[activeDataIndex];
      //alert(`Action "${action}" exécutée pour l'élément : m/z ${val.x.toFixed(4)} — ${val.y.toFixed(2)} %`);
	  console.log(chart.getSelectedPoints());
    } else {
      alert(`Action "${action}" exécutée sur le graphique général.`);
    }
    $menu.hide();
    activeDataIndex = null;
  });

  $(document).on('mousedown', function (e) {
    if (!$(e.target).closest('#contextmenu').length) $menu.hide();
  });
});
</script>
{% endblock %}