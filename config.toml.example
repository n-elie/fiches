# =============================================================================
# Configuration de l'application Fiches
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données
# -----------------------------------------------------------------------------
[database]
type = "mysql"             # Type de base de données : "mysql" ou "sqlite"
path = "analyses.db"       # Configuration SQLite (optionnelle, par défaut : analyses.db)
host = "localhost"         # Hôte MySQL
user = "root"              # Utilisateur MySQL
password = ""              # Mot de passe MySQL
name = "spectrometrie_db"  # Nom de la base de données

# -----------------------------------------------------------------------------
# LDAP
# -----------------------------------------------------------------------------
[ldap]
server = "ldap://localhost:389"
base_dn = "dc=example,dc=com"
bind_dn = "cn=admin,dc=example,dc=com"
bind_password = ""
user_search_base = "ou=users,dc=example,dc=com"
user_attributes = ["cn", "mail", "uid", "ou"]
team_attribute = "icsnEquipeNum"

# -----------------------------------------------------------------------------
# Application Flask
# -----------------------------------------------------------------------------
[app]
secret_key = "your-secret-key-here"  # Clé secrète pour Flask
upload_folder = "uploads"        # Dossier pour les uploads
allowed_extensions = ["cdx", "cdxml", "mol", "sdf"]  # Extensions autorisées
max_content_length = 16777216        # Taille max des uploads (16 Mo en octets)
port = 5000                            # Port de l'application
debug = true                           # Mode debug
admin_users = ["admin"]               # Utilisateurs administrateurs

# -----------------------------------------------------------------------------
# Services d'analyse (utilisés pour les fiches PDF)
# -----------------------------------------------------------------------------
[services.ms]
name = "Service HRMS"
responsible = "Someone"
phone = "1234"

[services.ms.solvents]
CH2Cl2 = "CH<sub>2</sub>Cl<sub>2</sub>"
MeOH = "Methanol"
ACN = "Acétonitrile"
H2O = "H<sub>2</sub>O"

[services.nmr]
name = "Service RMN"
responsible = "Otherone"
phone = "5678"

[services.nmr.solvents]
"" = "Non précisé"
AcOHd4 = "Acide Acétique-d4"
ACEd6 = "Acétone-d6"
ACNd3 = "Acétonitrile-d3"
PhHd6 = "Benzène-d6"
CDCl3 = "CDCl3"
CD2Cl2 = "CD2Cl2"
Cyd12 = "Cyclohexane-d12"
D2O = "D2O"
DMFd7 = "DMF-d7"
DMSOd6 = "DMSO-d6"
pDd8 = "p-Dioxane-d8"
EtOHd6 = "Ethanol-d6"
MeOHd4 = "Methanol-d4"
pyd5 = "Pyridine-d5"
THDd8 = "THF-d8"
PhMed8 = "Toluène-d8"
TFAd = "TFA-d"
TFEd3 = "Trifluoroéthanol-d3"

[services.nmr.stabilities]
0 = "Inconnue"
1 = "Stable"
2 = "Instable"
3 = "Très stable"

[services.nmr.experiments_by_frequency]
"500" = ["1H", "COSY", "HSQC", "HMQC", "HMBC", "NOESY", "ROESY", "HMQC-ND", "13C", "DEPT135", "DEPT90", "DEPT45", "P31", "P31-CPD"]
"700" = ["1H", "COSY", "HSQC", "HMBC", "NOESY", "ROESY", "13C", "DEPT135", "TOCSY", "HSQC 15N", "HMBC 15N"]

# -----------------------------------------------------------------------------
# Configuration Celery (pour les taches lourdes)
# -----------------------------------------------------------------------------
[celery]
broker_url = "redis://localhost:6379/0"
result_backend = "redis://localhost:6379/0"