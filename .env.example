# Configuration de l'application

# Clé secrète pour Flask
SECRET_KEY=votre_cle_secrete_ici

# Type de base de données (mysql ou sqlite)
DB_TYPE=mysql

# Configuration SQLite (optionnelle, par défaut : sqlite:///analyses.db)
DB_SQLITE_PATH=sqlite:///analyses.db

# Configuration MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=spectrometrie_db
DB_PORT=3306

# Configuration LDAP
LDAP_SERVER=ldap://votre_serveur_ldap
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=votre_mot_de_passe_ldap
LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_USER_ATTRIBUTES=uid,cn,mail,ou
LDAP_TEAM_ATTRIBUTE=ou

# Utilisateurs administrateurs (séparés par des virgules)
ADMIN_USERS=admin

# Dossier de téléchargement
UPLOAD_FOLDER=./uploads